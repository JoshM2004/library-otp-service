# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=library_otp_user
DB_PASSWORD="Ohmyjoe#040404"
DB_NAME=library_otp_db

# ---- OTP settings ----
# Long random secret used to HMAC the OTP. Generate it with the command in MASTER_NOTES / Stage 2.
OTP_HMAC_SECRET=replace_with_a_long_random_hex_string
# Production rule is 5 minutes. A smaller value is allowed ONLY when NODE_ENV=development (for testing).
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ---- Email (Gmail SMTP) ----
GMAIL_USER=your_sender_address@gmail.com
# 16-character Google App Password (NOT your normal Gmail password)
GMAIL_APP_PASSWORD=PASTE_16_CHAR_APP_PASSWORD_HERE
EMAIL_FROM_NAME=Library OTP Service
# 465 (default) or 587. Use 587 only if your network blocks 465.
SMTP_PORT=465

# ---- Admin (shared key for book management) ----
ADMIN_API_KEY=PASTE_A_LONG_RANDOM_KEY_HERE